@model IEnumerable<CampusFix.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between
        align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2">Manage Categories</h1>
            <p class="text-muted mb-0">
                Create and manage maintenance categories.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Category
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No categories exist yet. Add your first category.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Requests</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @category.Name
                                    </td>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(
                                            category.Description)
                                            ? "No description"
                                            : category.Description)
                                    </td>
                                    <td>
                                        @category.MaintenanceRequests.Count
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@category.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@category.Id"
                                               class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-controller="StaffRequests"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Maintenance Dashboard
        </a>
    </div>
</div>
