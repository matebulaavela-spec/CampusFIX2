@model CampusFix.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 text-danger">Delete Category</h1>

                    <p>
                        Are you sure you want to delete this category?
                    </p>

                    <dl class="row">
                        <dt class="col-sm-4">Name</dt>
                        <dd class="col-sm-8">@Model.Name</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description"
                                : Model.Description)
                        </dd>

                        <dt class="col-sm-4">Requests using it</dt>
                        <dd class="col-sm-8">
                            @Model.MaintenanceRequests.Count
                        </dd>
                    </dl>

                    @if (Model.MaintenanceRequests.Any())
                    {
                        <div class="alert alert-warning">
                            This category is used by existing requests.
                            It cannot be deleted.
                        </div>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to Categories
                        </a>
                    }
                    else
                    {
                        <form asp-action="Delete"
                              asp-route-id="@Model.Id"
                              method="post">
                            <button type="submit"
                                    class="btn btn-danger">
                                Confirm Delete
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
